# Server Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to source control.

# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 5000)
PORT=5000

# Node environment — set to 'production' on deployed servers
# Development: verbose errors, stack traces enabled
# Production: safe error messages, stack traces suppressed
NODE_ENV=development

# ─── Neon PostgreSQL ────────────────────────────────────────────────────────────
# Pooled connection string (used by Prisma at runtime — from Neon dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Unpooled direct connection string (used by Prisma for migrations — from Neon dashboard)
# Required when running: npx prisma migrate deploy
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# ─── UploadThing ────────────────────────────────────────────────────────────────
# Token from https://uploadthing.com/dashboard → your app → API Keys
UPLOADTHING_TOKEN=your_uploadthing_token_here

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed client origins
# Development: http://localhost:5173
# Production: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGIN=http://localhost:5173
